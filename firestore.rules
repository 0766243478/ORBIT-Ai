rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isValidLanguage(lang) {
      return lang is string && lang.size() == 2 && (lang == 'en' || lang == 'ar');
    }

    function isValidPrivacyMode(mode) {
      return mode is string && mode.size() <= 24 && (
        mode == 'STRICT_LOCAL' ||
        mode == 'BALANCED' ||
        mode == 'FLEXIBLE' ||
        mode == 'CUSTOM'
      );
    }

    function isValidRoute(route) {
      return route is string && route.size() <= 16 && (
        route == 'LOCAL' ||
        route == 'CLOUD' ||
        route == 'HYBRID' ||
        route == 'BLOCKED'
      );
    }

    function isValidCustomPrefs(prefs) {
      return prefs is map &&
        prefs.keys().hasAll([
          'allowCloudFallback',
          'redactPiiBeforeCloud',
          'maxCloudPayloadKb',
          'maxEstimatedCostUsd',
          'preferLocalForSimpleTasks',
          'blockAttachmentsInCloud'
        ]) &&
        prefs.keys().hasOnly([
          'allowCloudFallback',
          'redactPiiBeforeCloud',
          'maxCloudPayloadKb',
          'maxEstimatedCostUsd',
          'preferLocalForSimpleTasks',
          'blockAttachmentsInCloud'
        ]) &&
        prefs.allowCloudFallback is bool &&
        prefs.redactPiiBeforeCloud is bool &&
        prefs.maxCloudPayloadKb is number && prefs.maxCloudPayloadKb >= 1 && prefs.maxCloudPayloadKb <= 1024 &&
        prefs.maxEstimatedCostUsd is number && prefs.maxEstimatedCostUsd >= 0 && prefs.maxEstimatedCostUsd <= 10 &&
        prefs.preferLocalForSimpleTasks is bool &&
        prefs.blockAttachmentsInCloud is bool;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'language',
        'privacyMode',
        'persistConversations',
        'customPreferences',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'language',
        'privacyMode',
        'persistConversations',
        'customPreferences',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == userId &&
      data.uid == request.auth.uid &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.displayName is string && data.displayName.size() <= 120 &&
      isValidLanguage(data.language) &&
      isValidPrivacyMode(data.privacyMode) &&
      data.persistConversations is bool &&
      isValidCustomPrefs(data.customPreferences) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'language',
        'messageCount',
        'lastRoute',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'language',
        'messageCount',
        'lastRoute',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.ownerId) &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
      isValidLanguage(data.language) &&
      data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 500 &&
      isValidRoute(data.lastRoute) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMessage(data, conversationId) {
      return data.keys().hasAll([
        'ownerId',
        'conversationId',
        'role',
        'content',
        'route',
        'modelUsed',
        'latencyMs',
        'estimatedCostUsd',
        'privacyStatus',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'conversationId',
        'role',
        'content',
        'route',
        'modelUsed',
        'latencyMs',
        'estimatedCostUsd',
        'privacyStatus',
        'createdAt'
      ]) &&
      isValidId(data.ownerId) &&
      data.ownerId == request.auth.uid &&
      isValidId(data.conversationId) &&
      data.conversationId == conversationId &&
      data.role is string && data.role.size() <= 16 && (data.role == 'user' || data.role == 'assistant') &&
      data.content is string && data.content.size() >= 1 && data.content.size() <= 32000 &&
      isValidRoute(data.route) &&
      data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 100 &&
      data.latencyMs is number && data.latencyMs >= 0 && data.latencyMs <= 600000 &&
      data.estimatedCostUsd is number && data.estimatedCostUsd >= 0 && data.estimatedCostUsd <= 10 &&
      data.privacyStatus is string && data.privacyStatus.size() >= 1 && data.privacyStatus.size() <= 80 &&
      data.createdAt is timestamp;
    }

    function isValidTelemetryEntry(data) {
      return data.keys().hasAll([
        'ownerId',
        'taskType',
        'route',
        'modelUsed',
        'privacyMode',
        'estimatedLatencyMs',
        'actualLatencyMs',
        'estimatedCostUsd',
        'inputTokens',
        'outputTokens',
        'status',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'taskType',
        'route',
        'modelUsed',
        'privacyMode',
        'estimatedLatencyMs',
        'actualLatencyMs',
        'estimatedCostUsd',
        'inputTokens',
        'outputTokens',
        'status',
        'createdAt'
      ]) &&
      isValidId(data.ownerId) &&
      data.ownerId == request.auth.uid &&
      data.taskType is string && data.taskType.size() >= 1 && data.taskType.size() <= 64 &&
      isValidRoute(data.route) &&
      data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 100 &&
      isValidPrivacyMode(data.privacyMode) &&
      data.estimatedLatencyMs is number && data.estimatedLatencyMs >= 0 && data.estimatedLatencyMs <= 600000 &&
      data.actualLatencyMs is number && data.actualLatencyMs >= 0 && data.actualLatencyMs <= 600000 &&
      data.estimatedCostUsd is number && data.estimatedCostUsd >= 0 && data.estimatedCostUsd <= 10 &&
      data.inputTokens is int && data.inputTokens >= 0 && data.inputTokens <= 1000000 &&
      data.outputTokens is int && data.outputTokens >= 0 && data.outputTokens <= 1000000 &&
      data.status is string && data.status.size() <= 16 && (data.status == 'success' || data.status == 'blocked' || data.status == 'error') &&
      data.createdAt is timestamp;
    }

    // Owner-isolated PII & Preferences
    match /users/{userId}/private/profile {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'language',
          'privacyMode',
          'persistConversations',
          'customPreferences',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // User-owned Conversations
    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(conversationId) && isVerifiedUser() &&
        isValidConversation(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(conversationId) && isVerifiedUser() &&
        isValidConversation(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'lastRoute', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messageCount', 'lastRoute', 'updatedAt'])
        );
      allow delete: if isValidId(conversationId) && isVerifiedUser() && existing().ownerId == request.auth.uid;

      // Subcollection Messages protected by Master Gate get() on parent conversation
      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser() &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid &&
          existing().ownerId == request.auth.uid;
        allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser() &&
          isValidMessage(incoming(), conversationId) &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser() &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid &&
          existing().ownerId == request.auth.uid;
      }
    }

    // User-owned Telemetry (append & delete only, no tampering with historical metrics)
    match /telemetry/{entryId} {
      allow get: if isValidId(entryId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(entryId) && isVerifiedUser() &&
        isValidTelemetryEntry(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(entryId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
    }
  }
}
